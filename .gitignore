# Originally: "Nothing should be ignored since only CSS source files were added."
#
# v54 refactor: ignore runtime/build artifacts so the repository ships source
# only. These entries were added during the security + UI reorganisation.

# Python bytecode & caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Runtime data generated by the server (secrets, caches, quarantine, backups)
src/python/data/

# Synced/generated frontend artifacts in src/python/ (built by
# sync_frontend_assets.py + build_route_bundles.py + build_editor_bundle.py).
# Source of truth lives in src/js/, src/css/, src/html/, vendor/, assets/.
src/python/*.js
src/python/*.css
src/python/*.html
src/python/*.webmanifest
src/python/bundle-*
src/python/route-bundle*
src/python/page-assets-*
src/python/editor-suite.*
src/python/vendor/
src/python/assets/
src/python/licenses/

# Server runtime log
server.log
bandit_high.txt

# Local environment files (secrets are auto-generated into .env at startup
# via src/python/secrets_v54.py — never commit real secrets)
.env
.env.local
.env.*.local
