# ─────────────────────────────────────────────────────────────────────
# Line-ending policy.
# The repository stores every text file with LF and the working tree is
# LF too, so Windows and Linux checkouts agree byte-for-byte.
# ─────────────────────────────────────────────────────────────────────
* text=auto eol=lf

# Windows-native shell scripts are the one deliberate exception: cmd.exe
# and the legacy PowerShell ISE expect CRLF. These stay LF in the
# repository (renormalisation is a no-op for them) and are checked out
# as CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# ─────────────────────────────────────────────────────────────────────
# Binary assets: never apply line-ending conversion or text diffing.
# Covers the 22 self-hosted webfonts currently in the repository.
# ─────────────────────────────────────────────────────────────────────
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
