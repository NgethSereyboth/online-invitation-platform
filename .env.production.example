# Generate .env.production with prepare_production_env.py, and never commit it.
# Validate before deployment:
# python production_preflight.py --env-file .env.production --check-dependencies

EINVITE_PRODUCTION=1
EINVITE_REQUIRE_DURABLE_SERVICES=1
EINVITE_PUBLIC_BASE_URL=https://invite.example.com
EINVITE_ALLOWED_HOSTS=invite.example.com
EINVITE_COOKIE_SECURE=1
EINVITE_REQUIRE_VERIFIED_EMAIL=1
EINVITE_STRICT_SESSION_CSRF=1
EINVITE_DISCLOSE_HEALTH_DETAILS=0
EINVITE_ALLOW_LOCAL_ADMIN_BOOTSTRAP=0
EINVITE_JSON_LOGS=1
EINVITE_DATA_DIR=/data

# Compose service credentials. Generate long random values independently.
EINVITE_POSTGRES_PASSWORD=REPLACE_POSTGRES_PASSWORD
EINVITE_REDIS_PASSWORD=REPLACE_REDIS_PASSWORD
EINVITE_MINIO_ROOT_USER=REPLACE_MINIO_ACCESS_KEY
EINVITE_MINIO_ROOT_PASSWORD=REPLACE_MINIO_SECRET_KEY

# Stable application signing keys. Use at least 32 random characters and keep
# each value different. Rotating these values requires an explicit key plan.
EINVITE_UPLOAD_SIGNING_SECRET=REPLACE_UPLOAD_SIGNING_SECRET
EINVITE_MEDIA_SIGNING_SECRET=REPLACE_MEDIA_SIGNING_SECRET
EINVITE_GUEST_TOKEN_SECRET=REPLACE_GUEST_TOKEN_SECRET

# Compose overrides the URLs below with its internal service addresses. Keep
# them here so non-Compose production deployments have an explicit contract.
EINVITE_DATABASE_URL=postgresql://einvite:REPLACE_POSTGRES_PASSWORD@postgres:5432/einvite
EINVITE_REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@redis:6379/0
EINVITE_DATABASE_POOL_MIN=2
EINVITE_DATABASE_POOL_MAX=20

EINVITE_OBJECT_STORAGE_PROVIDER=minio
EINVITE_OBJECT_STORAGE_BUCKET=einvite-private
EINVITE_OBJECT_STORAGE_ENDPOINT=http://minio:9000
EINVITE_OBJECT_STORAGE_REGION=us-east-1
EINVITE_OBJECT_STORAGE_ACCESS_KEY=REPLACE_MINIO_ACCESS_KEY
EINVITE_OBJECT_STORAGE_SECRET_KEY=REPLACE_MINIO_SECRET_KEY
EINVITE_OBJECT_STORAGE_PUBLIC_BASE_URL=
# Only safe because MinIO is reached over the private Compose backend network.
EINVITE_ALLOW_INSECURE_OBJECT_STORAGE=1
EINVITE_BACKUP_PROVIDER=object

EINVITE_QUEUE_PROVIDER=local
EINVITE_COLLABORATION_PROVIDER=local
EINVITE_WORKER_CONCURRENCY=4
EINVITE_SCHEDULER_INTERVAL_SECONDS=60
EINVITE_MAINTENANCE_MODE=0

# Add only the exact reverse-proxy source IPs that are allowed to supply
# X-Forwarded-* headers. Leave empty when exposing the app directly.
EINVITE_TRUSTED_PROXY_IPS=

# Production uploads fail closed unless a platform-specific scanner is ready.
# DockerOnline supplies clamdscan; WindowsServer supplies Microsoft Defender.
EINVITE_MALWARE_SCANNER_COMMAND=
EINVITE_MALWARE_SCANNER_MODE=
EINVITE_REQUIRE_MALWARE_SCAN=1

EINVITE_MAX_REQUEST_BYTES=2000000
EINVITE_MAX_UPLOAD_BYTES=50000000
EINVITE_COLLABORATION_REPLAY_LIMIT=5000
EINVITE_COLLABORATION_UPDATE_BYTES=256000
EINVITE_RASTER_MAX_PIXELS=160000000
EINVITE_GUEST_RETENTION_DAYS=730
EINVITE_AUDIT_RETENTION_DAYS=730
EINVITE_WORKSPACE_TRASH_DAYS=30

EINVITE_FEATURE_V29=1
EINVITE_FEATURE_V30=1
EINVITE_FEATURE_V31=1
EINVITE_FEATURE_V32=1

# Optional integrations remain disabled until their provider credentials and
# webhook verification are configured and tested.
EINVITE_AI_PROVIDER=offline
EINVITE_AI_ENDPOINT=
EINVITE_AI_API_KEY=

# AI Project Operator local-provider routing (server-side only).
EINVITE_LOCAL_AI_ENABLED=0
# Optional JSON array: [{"id":"ollama","label":"Ollama","kind":"ollama","endpoint":"http://127.0.0.1:11434","enabled":true}]
EINVITE_LOCAL_AI_PROVIDERS_JSON=[]
# Comma-separated exact HTTP origins for non-loopback administrator-approved endpoints.
EINVITE_LOCAL_AI_ALLOWLIST=
# Role values use providerId:modelId. Roles: general, planning, vision, writing, translation, embedding.
EINVITE_AI_MODEL_ROLES_JSON={}
EINVITE_LOCAL_AI_TIMEOUT=5
EINVITE_LOCAL_AI_CONCURRENCY=1
# Optional private model discovery directory. Keep outside this project/public static tree. Files are metadata-only until registered in an approved runtime.
EINVITE_LOCAL_MODEL_DIR=

# Recursive materials/ZIP import safety limits.
EINVITE_MATERIAL_IMPORT_MAX_ARCHIVE_BYTES=100000000
EINVITE_MATERIAL_IMPORT_MAX_UNCOMPRESSED_BYTES=500000000
EINVITE_MATERIAL_IMPORT_MAX_ENTRIES=2000
EINVITE_MATERIAL_IMPORT_MAX_ENTRY_BYTES=50000000
EINVITE_MATERIAL_IMPORT_MAX_COMPRESSION_RATIO=250
# Hosted Visa/Mastercard checkout adapter. Use a PCI-compliant provider-hosted
# page; never expose the API key or collect raw card details in this app.
EINVITE_BILLING_PROVIDER_NAME=REPLACE_PROVIDER_DISPLAY_NAME
EINVITE_BILLING_CHECKOUT_ENDPOINT=https://REPLACE_BILLING_ADAPTER/checkout
EINVITE_BILLING_API_KEY=REPLACE_BILLING_API_KEY
EINVITE_BILLING_WEBHOOK_SECRET=REPLACE_LONG_RANDOM_WEBHOOK_SECRET
EINVITE_BILLING_CURRENCY=USD
EINVITE_CREATOR_PRICE_MINOR=900
EINVITE_STUDIO_PRICE_MINOR=2400
EINVITE_SMTP_HOST=
EINVITE_SMTP_PORT=587
EINVITE_SMTP_USER=
EINVITE_SMTP_PASSWORD=
EINVITE_MAIL_FROM=
EINVITE_ERROR_MONITOR_DSN=
EINVITE_TRACE_ENDPOINT=
