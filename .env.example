# V32 development-safe placeholders. Never commit real credentials.
EINVITE_PRODUCTION=0
EINVITE_REQUIRE_DURABLE_SERVICES=0
EINVITE_PUBLIC_BASE_URL=http://127.0.0.1:4175
EINVITE_COOKIE_SECURE=0
# Development compatibility defaults. Production forces strict session CSRF
# and disables unverified local administrator bootstrap regardless of overrides.
EINVITE_STRICT_SESSION_CSRF=0
EINVITE_DISCLOSE_HEALTH_DETAILS=1
EINVITE_ALLOW_LOCAL_ADMIN_BOOTSTRAP=1
EINVITE_DATA_DIR=./data
EINVITE_DATABASE_URL=
EINVITE_REDIS_URL=
EINVITE_PROCESS_ROLE=web
EINVITE_WORKER_CONCURRENCY=2
EINVITE_SCHEDULER_INTERVAL_SECONDS=60

# Cumulative feature flags. Disable individually for staged adoption.
EINVITE_FEATURE_V29=1
EINVITE_FEATURE_V30=1
EINVITE_FEATURE_V31=1
EINVITE_FEATURE_V32=1

# Local, s3, r2, or minio. Local remains the development default.
EINVITE_OBJECT_STORAGE_PROVIDER=local
EINVITE_OBJECT_STORAGE_BUCKET=
EINVITE_OBJECT_STORAGE_ENDPOINT=
EINVITE_OBJECT_STORAGE_REGION=auto
EINVITE_OBJECT_STORAGE_ACCESS_KEY=
EINVITE_OBJECT_STORAGE_SECRET_KEY=
EINVITE_OBJECT_STORAGE_PUBLIC_BASE_URL=
EINVITE_ALLOW_INSECURE_OBJECT_STORAGE=0
EINVITE_MEDIA_SIGNING_SECRET=
EINVITE_UPLOAD_SIGNING_SECRET=
EINVITE_GUEST_TOKEN_SECRET=

# Provider-neutral production roles.
EINVITE_QUEUE_PROVIDER=local
EINVITE_COLLABORATION_PROVIDER=local
EINVITE_BACKUP_PROVIDER=local
EINVITE_TRUSTED_PROXY_IPS=
EINVITE_MAINTENANCE_MODE=0

# Bounded platform limits.
EINVITE_MAX_REQUEST_BYTES=2000000
EINVITE_MAX_UPLOAD_BYTES=50000000
EINVITE_DATABASE_POOL_MIN=1
EINVITE_DATABASE_POOL_MAX=10
EINVITE_COLLABORATION_REPLAY_LIMIT=5000
EINVITE_COLLABORATION_UPDATE_BYTES=256000
EINVITE_RASTER_MAX_PIXELS=160000000
EINVITE_GUEST_RETENTION_DAYS=730
EINVITE_AUDIT_RETENTION_DAYS=730
EINVITE_WORKSPACE_TRASH_DAYS=30

# Existing provider adapters remain environment based.
EINVITE_AI_PROVIDER=offline
EINVITE_AI_ENDPOINT=
EINVITE_AI_API_KEY=

# AI Project Operator local-provider routing (server-side only).
EINVITE_LOCAL_AI_ENABLED=0
# Optional JSON array: [{"id":"ollama","label":"Ollama","kind":"ollama","endpoint":"http://127.0.0.1:11434","enabled":true}]
EINVITE_LOCAL_AI_PROVIDERS_JSON=[]
# Comma-separated exact HTTP origins for non-loopback administrator-approved endpoints.
EINVITE_LOCAL_AI_ALLOWLIST=
# Role values use providerId:modelId. Roles: general, planning, vision, writing, translation, embedding.
EINVITE_AI_MODEL_ROLES_JSON={}
EINVITE_LOCAL_AI_TIMEOUT=5
EINVITE_LOCAL_AI_CONCURRENCY=1
# Optional private model discovery directory. Keep outside this project/public static tree. Files are metadata-only until registered in an approved runtime.
EINVITE_LOCAL_MODEL_DIR=

# Recursive materials/ZIP import safety limits.
EINVITE_MATERIAL_IMPORT_MAX_ARCHIVE_BYTES=100000000
EINVITE_MATERIAL_IMPORT_MAX_UNCOMPRESSED_BYTES=500000000
EINVITE_MATERIAL_IMPORT_MAX_ENTRIES=2000
EINVITE_MATERIAL_IMPORT_MAX_ENTRY_BYTES=50000000
EINVITE_MATERIAL_IMPORT_MAX_COMPRESSION_RATIO=250
# Hosted card checkout adapter. The endpoint creates a provider-hosted session;
# full card numbers and security codes must never be sent to this application.
EINVITE_BILLING_PROVIDER_NAME=Secure card checkout
EINVITE_BILLING_CHECKOUT_ENDPOINT=
EINVITE_BILLING_API_KEY=
EINVITE_BILLING_WEBHOOK_SECRET=
EINVITE_BILLING_CURRENCY=USD
# Smallest currency unit: cents for USD and whole riel for KHR.
EINVITE_CREATOR_PRICE_MINOR=900
EINVITE_STUDIO_PRICE_MINOR=2400
EINVITE_SMTP_HOST=
EINVITE_SMTP_PORT=587
EINVITE_SMTP_USER=
EINVITE_SMTP_PASSWORD=
EINVITE_MAIL_FROM=
EINVITE_MESSAGING_WEBHOOK_ENDPOINT=
EINVITE_MESSAGING_WEBHOOK_SECRET=
EINVITE_BOT_PROTECTION_ENDPOINT=
EINVITE_BOT_PROTECTION_SECRET=
EINVITE_ERROR_MONITOR_DSN=
EINVITE_TRACE_ENDPOINT=
# V35 provider routing (JSON array; keys remain server-side environment variables)
EINVITE_AI_PROVIDER_ROUTES_JSON=[]

# V44 animation/export provider adapter
EINVITE_ANIMATION_EXPORT_PROVIDER=local-manifest
EINVITE_ANIMATION_EXPORT_ENDPOINT=

# V45 DNS/certificate provider adapters
EINVITE_DOMAIN_VERIFICATION_PROVIDER=development
EINVITE_DNS_PROVIDER_ENDPOINT=
EINVITE_CERTIFICATE_PROVIDER_ENDPOINT=

# V48 plugin package signing/trust anchors
EINVITE_PLUGIN_SIGNING_PUBLIC_KEYS_JSON=[]
EINVITE_PLUGIN_MARKETPLACE_ENDPOINT=

# V52 event notification/automation adapters
EINVITE_EVENT_NOTIFICATION_PROVIDER=development
EINVITE_EVENT_NOTIFICATION_ENDPOINT=
EINVITE_EVENT_NOTIFICATION_SECRET=
