# ---------------------------------------------------------------------------
# E-Invitation Website — environment template.
#
# Copy to ``.env`` and fill in real values before deploying to production.
# Secret values are auto-generated by ``features/secrets.py`` (ensure_secret)
# on first run if left blank — the generated value is written back into
# ``.env`` and ``os.environ``.  Never commit the real ``.env`` file; it is
# already listed in ``.gitignore``.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
# Application mode.  Set to "1" for production (enables HSTS, email
# verification, local-admin bootstrap lock-out, strict host validation).
EINVITE_PRODUCTION_MODE=

# Secret key for session signing / CSRF.  Auto-generated if blank.
EINVITE_SECRET_KEY=

# Cookie security.  Set to "1" behind HTTPS so cookies carry the Secure flag
# and HSTS is emitted.  Must be "1" for any public HTTPS deployment.
EINVITE_COOKIE_SECURE=

# Session cookie name override (optional).
EINVITE_SESSION_COOKIE=

# --- Hosts / URLs ----------------------------------------------------------
# Comma-separated list of allowed Host header values (required in production).
EINVITE_ALLOWED_HOSTS=

# Public-facing base URL (used for absolute links in email, webhooks).
EINVITE_BASE_URL=

# Trusted reverse-proxy IP addresses (comma-separated) that may send
# X-Forwarded-For / X-Forwarded-Proto.
EINVITE_TRUSTED_PROXY_IPS=

# Admin route IP allowlist (comma-separated CIDR ranges).
EINVITE_ADMIN_IP_ALLOWLIST=

# --- Database --------------------------------------------------------------
# SQLite path (default).  Leave empty for the built-in default.
EINVITE_DATA=

# PostgreSQL URL (optional — set to override SQLite).
EINVITE_DATABASE_URL=

# --- Object storage (S3 / S3-compatible) -----------------------------------
EINVITE_OBJECT_STORAGE_KMS_KEY_ID=
EINVITE_OBJECT_STORAGE_VERSIONING=
EINVITE_ACCESS_KEY_ID=
EINVITE_SECRET_ACCESS_KEY=
EINVITE_OBJECT_STORAGE_BUCKET=
EINVITE_OBJECT_STORAGE_REGION=
EINVITE_OBJECT_STORAGE_ENDPOINT=

# --- Media / uploads -------------------------------------------------------
# Enable user-generated background media (audio / video).
EINVITE_BACKGROUND_MEDIA=

# Days before trashed media are permanently deleted.
EINVITE_MEDIA_TRASH_DAYS=

# --- Billing (payment provider) --------------------------------------------
EINVITE_BILLING_PROVIDER=
EINVITE_BILLING_WEBHOOK_SECRET=
EINVITE_BILLING_CHECKOUT_ENDPOINT=
EINVITE_BILLING_API_KEY=
EINVITE_BILLING_CURRENCY=
EINVITE_CREATOR_PRICE_MINOR=
EINVITE_STUDIO_PRICE_MINOR=
EINVITE_STUDIO_PRICE_OVERAGE_GB=

# Stripe (Phase 5 — optional integration)
EINVITE_STRIPE_SECRET_KEY=
EINVITE_STRIPE_PUBLISHABLE_KEY=
EINVITE_STRIPE_WEBHOOK_SECRET=
EINVITE_STRIPE_PRICE_STANDARD_MONTH=
EINVITE_STRIPE_PRICE_STANDARD_YEAR=
EINVITE_STRIPE_PRICE_PRO_MONTH=
EINVITE_STRIPE_PRICE_PRO_YEAR=

# --- Canva bridge (Phase 5.1 — optional) -----------------------------------
EINVITE_CANVA_CLIENT_ID=
EINVITE_CANVA_CLIENT_SECRET=
EINVITE_CANVA_OAUTH_REDIRECT_URI=

# --- Rate-limiting store ---------------------------------------------------
# Redis URL.  When unset, the server uses an in-process token bucket.
EINVITE_REDIS_URL=

# --- Bot protection (reCAPTCHA / Turnstile) --------------------------------
EINVITE_BOT_PROTECTION_ENDPOINT=
EINVITE_BOT_PROTECTION_SECRET=

# --- Security scanner (ClamAV / Defender) ----------------------------------
# Set EINVITE_ALLOW_NO_SCANNER=1 to bypass the startup scanner check
# (NOT recommended for production).
EINVITE_ALLOW_NO_SCANNER=

# --- Legacy env-var aliases (SOVAN_*) --------------------------------------
# Retained for backward compatibility with pre-V42 deployments.
SOVAN_SECRET_KEY=
SOVAN_BILLING_WEBHOOK_SECRET=
