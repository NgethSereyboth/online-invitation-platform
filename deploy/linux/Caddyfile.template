__DOMAIN__ {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8080 {
        health_uri /api/health/live
        health_interval 30s
        health_timeout 5s
    }
    header {
        -Server
    }
    log {
        output file /var/log/caddy/einvite-access.json {
            roll_size 25MiB
            roll_keep 10
            roll_keep_for 720h
        }
        format json
    }
}
