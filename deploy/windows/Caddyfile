{$EINVITE_DOMAIN} {
    encode zstd gzip
    reverse_proxy 127.0.0.1:{$EINVITE_BACKEND_PORT} {
        health_uri /api/health/live
        health_interval 30s
        health_timeout 5s
    }
    header {
        -Server
    }
    log {
        output file {$EINVITE_CADDY_LOG} {
            roll_size 25MiB
            roll_keep 10
            roll_keep_for 720h
        }
        format json
    }
}
