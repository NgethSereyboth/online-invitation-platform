{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:8124/index.html",
        "http://127.0.0.1:8124/dashboard.html",
        "http://127.0.0.1:8124/public.html",
        "http://127.0.0.1:8124/admin.html",
        "http://127.0.0.1:8124/account.html",
        "http://127.0.0.1:8124/billing.html",
        "http://127.0.0.1:8124/verify.html",
        "http://127.0.0.1:8124/reset.html",
        "http://127.0.0.1:8124/privacy.html",
        "http://127.0.0.1:8124/guests.html",
        "http://127.0.0.1:8124/responses.html",
        "http://127.0.0.1:8124/analytics.html",
        "http://127.0.0.1:8124/materials.html",
        "http://127.0.0.1:8124/checkin.html",
        "http://127.0.0.1:8124/templates.html",
        "http://127.0.0.1:8124/designer.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromePath": "/usr/bin/google-chrome",
        "chromeFlags": "--headless=new --no-sandbox --disable-dev-shm-usage --disable-gpu",
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"]
      }
    },
    "assert": {
      "budgetsFile": "./docs/perf/lighthouse-budgets.json"
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./docs/reviews/lighthouse"
    }
  }
}
